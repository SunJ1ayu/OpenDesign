#!/usr/bin/env python3
"""人工批准闸 — 唯一能创建 `.approved` 标记的通道。

模型(MCP)没有任何工具能造这个标记,所以未经这里批准的整理方案物理上执行不了。
清单由工具从 plan json 渲染打印,不经模型转述。

用法:  ds-approve <plan_id>        (DS_ROOT 可用环境变量覆盖)
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import ds_organize  # noqa: E402


def main() -> int:
    # Windows 控制台(cp936)编不出的字符降级成 ? 而不是崩(summary 里可能有任意文件名)
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors="replace")
        except Exception:
            pass
    if len(sys.argv) != 2:
        print("用法: ds-approve <plan_id>", file=sys.stderr)
        return 2
    plan_id = sys.argv[1]
    ds_root = os.environ.get("DS_ROOT", ds_organize.DEFAULT_DS_ROOT)
    r = ds_organize.approve_plan(plan_id, ds_root=ds_root)
    if not r.get("ok"):
        print(f"拒绝: {r.get('error')}", file=sys.stderr)
        return 1
    print("将要执行的操作:")
    print(r["summary"])
    print(f"\n已批准 plan {plan_id} —— 现在可以让 agent 跑 apply_plan 了。")
    return 0


if __name__ == "__main__":
    sys.exit(main())
